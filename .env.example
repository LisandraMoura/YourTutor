# YourTutor — exemplo de configuração (§9 da especificação)
#
# Copie este arquivo e preencha as três chaves obrigatórias:
#
#     cp .env.example .env
#
# O `.env` está no `.gitignore` e nunca é versionado. Nada aqui é um valor real:
# as chaves de segredo ficam vazias de propósito e a subida falha, com a lista
# completa do que falta, enquanto não forem preenchidas.
#
# Precedência de leitura (app/config.py): variável de ambiente real > `.env` > default.
# Chave declarada vazia é tratada como ausente: cai no default ou, se for
# obrigatória, produz erro claro na subida.
#
# Este arquivo é a lista autoritativa dos defaults. Todo valor abaixo já é o
# default aplicado pelo `app/config.py` quando a chave está ausente.
#
# Legenda de consumidor:
#   [app]   lida e validada pelo `app/config.py`
#   [infra] lida apenas pelo docker-compose/Makefile; a aplicação não valida
#   [ambos] lida pelos dois

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------

# [ambos] Nome da sessão do WPPConnect; também nomeia o volume de sessão.
WPP_SESSION_NAME=yourtutor

# [ambos] URL do WPPConnect Server. Default aponta para o serviço do compose.
WPP_SERVER_URL=http://wppconnect:21465

# [ambos] OBRIGATÓRIA — sem default. Segredo do WPPConnect usado para gerar o
# token da sessão. Preencha no seu `.env`; nunca versione o valor.
WPP_SECRET_KEY=

# [ambos] Endpoint da API que recebe os webhooks do WPPConnect.
WPP_WEBHOOK_URL=http://api:8000/webhook

# [app] Opcional, vazia por default. Número do próprio bot em formato E.164:
# `+` seguido de 8 a 15 dígitos. O pareamento é por QR code, então o sistema
# funciona sem este valor; ele é validado apenas se preenchido. Nenhum número
# real é versionado aqui (regra inviolável 5).
BOT_PHONE_NUMBER=

# [infra] Porta do WPPConnect publicada pelo container. Uso exclusivo da
# infraestrutura (docker-compose): a aplicação alcança o serviço por
# WPP_SERVER_URL e não lê nem valida esta chave.
WPP_PORT=21465

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------

# [app] OBRIGATÓRIA — sem default. Preencha no seu `.env`.
OPENAI_API_KEY=

# [app] Modelo de chat usado por todos os agentes (§5). Modelo completo por
# decisão de projeto: a qualidade do tutor deve ser avaliada sem interferência
# de limitação de modelo. Trocar é uma linha aqui, sem tocar em código.
OPENAI_MODEL_CHAT=gpt-4o

# [app] STT (RF3). Alternativa prevista na spec: gpt-4o-transcribe.
OPENAI_MODEL_STT=whisper-1

# [app] TTS (RF5). Alternativa prevista na spec: tts-1.
OPENAI_MODEL_TTS=gpt-4o-mini-tts

# [app] Voz do TTS. Trocável por uma linha aqui, como o modelo.
OPENAI_TTS_VOICE=alloy

# [app] Temperatura das chamadas de chat. Faixa aceita: 0.0 a 2.0.
OPENAI_TEMPERATURE=0.7

# [app] Teto de tokens por resposta. Inteiro maior que zero.
OPENAI_MAX_TOKENS=800

# [app] Teto por chamada à OpenAI, em segundos (RNF3). Não confundir com o
# RNF1: os 15s de lá são meta de resposta ponta a ponta (STT + LLM + TTS),
# medida no fluxo inteiro, e não um teto por chamada. Este valor existe para
# impedir que uma requisição fique pendurada indefinidamente.
OPENAI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Pedagógico
# ---------------------------------------------------------------------------

# [app] Nível CEFR inicial. Aceita A1, A2, B1, B2, C1 ou C2 (sem distinção de caixa).
DEFAULT_LEVEL=A1

# [app] Teto duro de turnos por lição (RA3). Decisão D2, resolvida.
MAX_TURNS_PER_LESSON=10

# [app] Perguntas-âncora por lição. RA2 fixa o teto em 6; valor maior é recusado.
MAX_ANCHOR_QUESTIONS=6

# [app] Itens de conhecimento gerados pelo Planejador por nível. Decisão D1, resolvida.
ITEMS_PER_LEVEL=12

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------

# [ambos] Host do Postgres. Default aponta para o serviço do compose.
POSTGRES_HOST=postgres

# [ambos] Porta do Postgres dentro da rede dos containers.
POSTGRES_PORT=5432

# [ambos] Nome do banco; o compose usa para inicializar o cluster.
POSTGRES_DB=yourtutor

# [ambos] Usuário do banco; o compose usa para inicializar o cluster.
POSTGRES_USER=yourtutor

# [ambos] OBRIGATÓRIA — sem default. Preencha no seu `.env`.
POSTGRES_PASSWORD=

# [ambos] Opcional. Deixe vazia para que a aplicação derive a URL das cinco
# chaves POSTGRES_* acima — é o caminho normal. Preencha apenas para apontar
# para um Postgres gerenciado externo: se tiver valor, ele tem precedência
# sobre a URL derivada.
DATABASE_URL=

# [infra] Opcional. Porta em que o Postgres é publicado na máquina host.
# Padrão é NÃO expor o banco para fora dos containers; deixe vazia. Preencha
# (ex.: 5432) apenas para inspecionar o banco com um cliente externo.
# Uso exclusivo da infraestrutura: a aplicação não lê nem valida esta chave.
POSTGRES_HOST_PORT=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

# [ambos] Porta da API, tanto no bind interno quanto na publicação do compose.
API_PORT=8000

# [app] Nível de log. Aceita DEBUG, INFO, WARNING, ERROR ou CRITICAL.
LOG_LEVEL=INFO

# [infra] Prefixo fixo dos containers, redes e volumes do compose. Sem ela o
# nome deriva do diretório de trabalho, o que torna instável o alvo do
# `make reset` (cada worktree tem nome de pasta diferente).
# Uso exclusivo da infraestrutura: a aplicação não lê nem valida esta chave.
COMPOSE_PROJECT_NAME=yourtutor
